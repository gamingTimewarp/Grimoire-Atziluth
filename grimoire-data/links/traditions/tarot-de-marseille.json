    { "source": "tarot.major.tdm.la-justice",         "target": "tarot.major.tdm.la-force",  "label": "tdm-pre-waite-numbering-swap", "traditionScope": ["tarot-de-marseille"], "extendedData": { "tdmJusticeNumber": 8, "tdmForceNumber": 11, "note": "In the Marseille tradition Justice=8 and La Force=11. Waite swapped these to Justice=11 and Strength=8 in 1910, which the RWS and GD codified. Crowley restored the original Marseille order in the Thoth deck." } },
